{
  "name": "waku-cache",
  "description": "Cache for React Server Components in Waku",
  "version": "0.0.1",
  "type": "module",
  "author": "Daishi Kato",
  "repository": {
    "type": "git",
    "url": "https://github.com/wakujs/waku-cache.git"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stores/memory": {
      "types": "./dist/stores/memory.d.ts",
      "default": "./dist/stores/memory.js"
    },
    "./stores/unstorage": {
      "types": "./dist/stores/unstorage.d.ts",
      "default": "./dist/stores/unstorage.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "compile": "rm -rf dist && tsc -p .",
    "test": "pnpm run '/^test:.*/'",
    "test:format": "prettier -c .",
    "test:lint": "eslint .",
    "test:types": "tsc -p . --noEmit",
    "test:types:examples": "tsc -p examples --noEmit",
    "test:types:tests": "tsc -p tsconfig.tests.json",
    "test:spec": "vitest run",
    "e2e": "pnpm compile && playwright test",
    "examples:01_minimal": "(cd examples/01_minimal; waku dev)"
  },
  "keywords": [
    "react",
    "waku",
    "cache"
  ],
  "license": "MIT",
  "prettier": {
    "singleQuote": true
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.4",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-server-dom-webpack": "~19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "unstorage": "^1.17.5",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "waku": "1.0.0-rc.4",
    "waku-cache": "link:"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-server-dom-webpack": ">=19.0.0",
    "unstorage": ">=1.10.0",
    "waku": ">=1.0.0-rc.4"
  },
  "peerDependenciesMeta": {
    "unstorage": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
